# Your instance. Only its accounts can sign in, and it can't be changed at runtime.
AGENDE_INSTANCE=https://example.social

# Where this app is served, always https.
AGENDE_BASE_URL=https://agende.example.social

# OAuth application, see README.md.
AGENDE_CLIENT_ID=
AGENDE_CLIENT_SECRET=

# Encrypts tokens and the audit excerpts: openssl rand -hex 32
AGENDE_ENCRYPTION_KEY=

# Database created with schema.sql, see README.md.
AGENDE_DB_HOST=postgres
AGENDE_DB_PASSWORD=change-me

AGENDE_REDIS_ADDR=redis:6379
AGENDE_REDIS_PASSWORD=change-me

# Optional, defaults shown.
#AGENDE_DB_PORT=5432
#AGENDE_DB_USER=agende
#AGENDE_DB_NAME=agende
#AGENDE_DB_SSLMODE=prefer
#AGENDE_LANG=en
#AGENDE_TIMEZONE=UTC
#AGENDE_MAX_UPLOAD_MB=100

# Optional: delegation, so one account can schedule posts as another. Needs its
# own OAuth app (see README.md) and its own key. Off unless all three are set.
#AGENDE_DELEGATION_CLIENT_ID=
#AGENDE_DELEGATION_CLIENT_SECRET=
#AGENDE_DELEGATION_KEY=

# Only for instances that support these, such as a Mastodon fork with Markdown.
# Plain Mastodon would publish Markdown as raw text, so they are off by default.
#AGENDE_MARKDOWN=false
#AGENDE_LOCAL_ONLY=false
#AGENDE_EXPIRING=false
